# ==========================================
# TaskPilot .gitignore
# ==========================================

# Secrets — NEVER commit these
.env
*.env
.env.local

# Maven build output
target/
*.class
*.jar
*.war

# Node.js / Frontend
node_modules/
dist/
.nuxt/
.cache/
.vuepress/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# macOS
.DS_Store
._*
.Spotlight-V2
.Trashes

# Logs
*.log
logs/

# Test reports (optional — uncomment to exclude)
# target/surefire-reports/

# Spring Boot DevTools
.spring-boot-devtools.properties
